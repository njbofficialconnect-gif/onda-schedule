# 이 파일을 복사해서 ".env" 라는 이름으로 저장하고, 실제 값을 채워넣으세요.
# ".env" 파일 자체는 git에 올라가지 않습니다 (.gitignore 처리됨).

# Flask 세션 암호화에 쓰이는 임의의 문자열 (아무 긴 랜덤 문자열이나 넣으면 됩니다)
FLASK_SECRET_KEY=여기에-아무-긴-임의의-문자열을-넣으세요

# 이메일을 보낼 Gmail 계정
GMAIL_ADDRESS=njb.official.connect@gmail.com

# 위 Gmail 계정의 "앱 비밀번호" (일반 로그인 비밀번호 아님!)
# 만드는 방법:
#  1) https://myaccount.google.com/security 접속 (njb.official.connect@gmail.com으로 로그인)
#  2) "2단계 인증"을 먼저 켠다 (안 켜져 있으면 앱 비밀번호 메뉴 자체가 안 보임)
#  3) https://myaccount.google.com/apppasswords 에서 앱 이름을 아무거나 적고 "만들기"
#  4) 생성된 16자리 비밀번호(공백 제외하고 붙여넣기)를 아래에 입력
GMAIL_APP_PASSWORD=

# 이 앱이 실제로 접속되는 주소. 로컬 개발은 기본값 그대로 두면 됩니다.
# 실제 서버에 배포하면 그 주소로 바꿔주세요 (예: https://onda.example.com) - 카카오
# 리다이렉트/알림 링크에 쓰입니다.
APP_BASE_URL=http://127.0.0.1:5050

# 카카오톡 "나에게 보내기" 알림 (하루전/1시간전) 연동에 필요. 안 채우면 캘린더는 정상
# 작동하고 카카오 알림 기능만 꺼진 채로 동작합니다.
# 만드는 방법:
#  1) https://developers.kakao.com 접속 > 내 애플리케이션 > 애플리케이션 추가
#  2) [앱 설정 > 요약 정보]의 "REST API 키"를 KAKAO_REST_API_KEY에 입력
#  3) [제품 설정 > 카카오 로그인] 활성화, Redirect URI에
#     "{APP_BASE_URL}/kakao/callback" (예: http://127.0.0.1:5050/kakao/callback) 등록
#  4) [제품 설정 > 카카오 로그인 > 동의항목]에서 "카카오톡 메시지 전송" 동의항목을
#     "선택 동의"로 설정 (없으면 신청)
#  5) [앱 설정 > 팀원 관리]에 박현기/변시원/박현우 3명의 카카오 계정을 팀원으로 추가
#     (앱을 정식 심사에 올리기 전까지는 등록된 팀원만 로그인 연동이 가능합니다)
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=http://127.0.0.1:5050/kakao/callback
